                      "maxLength": 256
                    },
                    "state": {
                      "type": "string",
                      "enum": ["DRAFT", "ARCHIVED", "PUBLISHED"],
                      "maxLength": 32
                    }
                  },
                  "required": ["id", "state"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
