    {
      "id": "order-lifecycle",
      "module": "fixtures/api/order-lifecycle.ts",
      "startExport": "startOrderFixture",
      "openapi": "fixtures/openapi/order-lifecycle.json",
      "variants": {
        "inconsistent": false,
        "repaired": true
      },
      "baseline": {
        "orders": 0
      },
      "operationPolicy": [
        {
          "operationId": "POST /api/control/reset",
          "category": "RESET",
          "phases": ["RESET"]
        },
        {
          "operationId": "GET /api/control/baseline",
          "category": "BASELINE",
          "phases": ["BASELINE"]
        },
        {
          "operationId": "POST /api/orders",
          "category": "EXPLORATION",
          "phases": ["EXPLORATION", "REPLAY", "MINIMIZATION", "ARTIFACT"]
        },
        {
          "operationId": "GET /api/orders/{orderId}",
          "category": "EXPLORATION",
          "phases": ["EXPLORATION", "REPLAY", "MINIMIZATION", "ARTIFACT"]
        },
        {
          "operationId": "POST /api/orders/{orderId}/cancel",
          "category": "EXPLORATION",
          "phases": ["EXPLORATION", "REPLAY", "MINIMIZATION", "ARTIFACT"]
        },
        {
          "operationId": "POST /api/orders/{orderId}/fulfill",
          "category": "EXPLORATION",
          "phases": ["EXPLORATION", "REPLAY", "MINIMIZATION", "ARTIFACT"]
        }
      ],
      "invariant": {
        "sourceRef": "an order observed as CANCELLED must not later be observed as FULFILLED within the same fresh trial",
        "applicability": [
          {
            "op": "equals",
            "left": {
              "kind": "json",
              "stepId": "cancelled",
              "pointer": "/state"
            },
            "right": {
              "kind": "literal",
              "value": "CANCELLED"
            }
          },
          {
            "op": "equals",
            "left": {
              "kind": "json",
              "stepId": "cancelled",
              "pointer": "/id"
            },
            "right": {
              "kind": "json",
              "stepId": "later",
              "pointer": "/id"
            }
          },
          {
            "op": "before",
            "left": {
              "kind": "step-index",
              "stepId": "cancelled"
            },
            "right": {
              "kind": "step-index",
              "stepId": "later"
            }
          }
        ],
        "assertions": [
          {
            "op": "not-equals",
            "left": {
              "kind": "json",
              "stepId": "later",
              "pointer": "/state"
            },
            "right": {
              "kind": "literal",
              "value": "FULFILLED"
            }
          }
        ]
      },
      "evaluator": {
        "priorStep": "cancelled",
        "laterStep": "later",
        "actions": [
          "POST /api/orders",
          "POST /api/orders/{orderId}/cancel",
          "POST /api/orders/{orderId}/fulfill"
        ],
        "inconsistentState": "FULFILLED",
        "repairedState": "CANCELLED"
      }
    },
