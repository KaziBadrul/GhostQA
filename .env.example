DATABASE_URL=postgresql://localhost:5432/ghostqa
# Neon: set the direct URL for supervisor session locks and migrations.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=verify-full
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=replace-with-an-available-model
GEMINI_REQUESTS_PER_MINUTE=12
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GHOSTQA_CREDENTIAL_KEY=replace-with-64-hexadecimal-characters
# Hosted single-owner mode only. Render supplies RENDER_EXTERNAL_URL automatically.
# GHOSTQA_PUBLIC_ORIGIN=https://your-service.onrender.com
# GHOSTQA_ADMIN_PASSWORD=choose-a-unique-password-of-at-least-32-characters
