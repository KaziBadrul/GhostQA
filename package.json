{
  "name": "ghostqa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build:engine && tsx server.ts",
    "build": "npm run build:engine && next build --webpack",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx src/server/migrate.ts",
    "build:engine": "node scripts/build-engine.mjs",
    "fixture": "tsx fixtures/api/server.ts",
    "pretest": "npm run build:engine",
    "pretest:unit": "npm run build:engine",
    "pretest:contract": "npm run build:engine",
    "pretest:integration": "npm run build:engine",
    "benchmark": "npm run build:engine && tsx src/cli/benchmark.ts",
    "test:artifacts": "npm run build:engine && vitest run tests/integration/artifact-acceptance.test.ts",
    "example": "tsx examples/server.ts",
    "dev:mcp": "npm run build:engine && next dev --webpack --hostname 127.0.0.1"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@scalar/openapi-parser": "0.29.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
